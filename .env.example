# ============================================
# Cloud Notes App - Backend Environment Config
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git!

# Amazon RDS Connection Details
# Get the endpoint from AWS Console -> RDS -> Databases -> Your DB -> Connectivity & security
DB_MODE=mysql
DB_HOST=your-rds-endpoint.xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-strong-password-here
DB_NAME=cloudnotes

# Server Port
PORT=5000

# AWS deployment defaults to DB_MODE=file and stores notes on the encrypted EBS volume.
# Leave the MySQL settings unset when using file mode.
